S|${HOME}/.config/hypr|wallbash|hyprland bash imagemagick

O|${HOME}/.local/share|hypr|hyprland
O|${HOME}/.local/bin|prodi-shell|hyprland
O|${HOME}/.local/share|prodi|hyprland
O|${HOME}/.local/lib|prodi|hyprland
O|${HOME}/.local/share|wallbash|bash imagemagick

