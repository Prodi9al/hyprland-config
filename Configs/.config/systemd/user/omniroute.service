[Unit]
Description=OmniRoute - Smart AI Router
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/.npm-global/lib/node_modules/omniroute/bin/omniroute.mjs serve --no-open
Restart=always
RestartSec=3
Environment=HOME=%h
WorkingDirectory=%h
EnvironmentFile=%h/.omniroute/.env

[Install]
WantedBy=default.target
